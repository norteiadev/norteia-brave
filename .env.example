# Database (psycopg 3 URL format). In Docker these two are overridden by docker-compose.yml.
BRAVE_DB_URL=postgresql+psycopg://brave:brave@localhost:5432/norteia_brave
BRAVE_DB_REDIS_URL=redis://localhost:6379/0

# Auth — FastAPI Bearer gate for the dashboard BFF (must equal dashboard/.env.local),
# X-Steward-Secret for DLQ mutations, X-Webhook-Secret for POST /webhook/error-report.
# Generate each with: openssl rand -hex 32
BRAVE_DASHBOARD_BEARER_TOKEN=change-me
BRAVE_STEWARD_SECRET=change-me
BRAVE_WEBHOOK_SECRET=change-me

# Set to true to allow real external API calls (keep 0 in CI / the offline suite)
RUN_REAL_EXTERNALS=0

# LLM — OpenRouter (DeepSeek backend extraction/scoring)
BRAVE_LLM_OPENROUTER_API_KEY=your_openrouter_key_here
BRAVE_LLM_DEEPSEEK_PRIMARY_SLUG=deepseek/deepseek-chat
# LLM — Anthropic (Claude Sonnet; WhatsApp + the non-cascade copywriter)
BRAVE_LLM_ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Places API (New) — atrativos discovery (Places FSM) + TA opening-hours/liveness
# enrichment. Requires "Places API (New)" enabled + billing on the GCP project.
BRAVE_PLACES_API_KEY=your_google_places_key_here
# Optional: a separate key for the daily Place Details refresh (brave.refresh_places) —
# own spend counters. Empty = the refresh uses BRAVE_PLACES_API_KEY.
BRAVE_PLACES_REFRESH_API_KEY=

# Parallel Search API — the atrativo description cascade's web search
# (atrativo_description_cascade_enabled).
PARALLEL_API_KEY=your_parallel_key_here
PARALLEL_SEARCH_MODE=turbo

# Cascade writer: Gemini 2.5 Flash direct on Google AI Studio (key needs billing enabled).
# Flex tier with standard fallback; BRAVE_LLM_GEMINI_SERVICE_TIER=standard switches Flex off.
# Rollback to OpenRouter without a deploy: ATRATIVO_CASCADE_MODEL=google/gemini-2.5-flash
BRAVE_LLM_GEMINI_API_KEY=your_gemini_key_here
BRAVE_LLM_GEMINI_SERVICE_TIER=flex
ATRATIVO_CASCADE_MODEL=gemini-2.5-flash

# Norteia API — Mar push. Sanctum token (ability territorial:ingest) is "id|secret":
# keep it QUOTED, an unquoted "|" breaks `set -a; . ./.env`. Tokens expire after 30 days
# (sanctum.expiration), so renew before a long run.
BRAVE_NORTEIA_API_URL=http://norteia-api.ddev.site
BRAVE_NORTEIA_API_SERVICE_TOKEN="your_service_token_here"

# Score version stamped on records
BRAVE_SCORE_SCORE_VERSION=v1.1
